# Copy this file to .env and fill in your own values. Never commit the real .env.

# Port the Express server listens on.
PORT=3000

# Public URL of your deployed site, used for the uptime status check.
# Leave blank on Vercel to use the deployed site's own URL automatically.
SITE_URL=

# Discord webhook that receives the live ONLINE/OFFLINE website status embed
# (posted/edited automatically every STATUS_INTERVAL_MS).
DISCORD_WEBHOOK_URL=

# Discord webhook that receives site activity logs (page views, downloads, errors)
# from public/site.html via POST /api/log. This is intentionally separate from
# DISCORD_WEBHOOK_URL above and is kept server-side only — the browser never sees it.
DISCORD_LOG_WEBHOOK_URL=

# Optional: reuse an existing Discord message for the status embed instead of
# posting a new one on every restart.
DISCORD_STATUS_MESSAGE_ID=

# How often (ms) to refresh the status embed. Minimum enforced is 60000 (1 minute).
STATUS_INTERVAL_MS=300000

# Optional separate webhook for a compact statistics feed. If blank, website stats
# are included in the normal status webhook embed.
DISCORD_STATS_WEBHOOK_URL=

# Vercel notes:
# - Do not commit a real .env file.
# - Website stats use in-memory runtime storage on Vercel and can reset when the function restarts.
# - Creator uploads are ephemeral on Vercel until durable storage (such as Vercel Blob) is connected.
